# {{ ansible_managed }}
{% macro app_config() %}
        ServerName {{ domain }}
{% for alias in domain_aliases %}
        ServerAlias {{ alias }}
{% endfor %}
        DocumentRoot {{ deploy_to }}/current/public

        <IfModule mpm_itk_module>
                AssignUserId {{ app_user }} {{ app_user }}
        </IfModule>

        <Directory {{ deploy_to }}/current/public>
                Options -Indexes +FollowSymLinks
                AllowOverride None
                Require all granted
                FallbackResource /index.php
                # Bez tego nagłówek Authorization (Bearer) nie dociera do PHP przez FPM.
                CGIPassAuth On
                # mod_php 8.1 jest włączony globalnie dla pozostałych stron;
                # tutaj PHP ma iść wyłącznie przez pulę FPM.
                <IfModule mod_php.c>
                        php_admin_flag engine off
                </IfModule>
        </Directory>

{% if basic_auth_enabled | bool %}
        <Location />
                AuthType Basic
                AuthName "{{ domain }}"
                AuthUserFile {{ htpasswd_file }}
                Require valid-user
        </Location>
        # Klienci API mają własne hasło (?pwd=) i nie obsługują Basic Auth.
        <Location /api/>
                Require all granted
        </Location>
        <Location /healthz>
                Require all granted
        </Location>
        <Location /.well-known/acme-challenge/>
                Require all granted
        </Location>

{% endif %}
        <FilesMatch "\.php$">
                SetHandler "proxy:unix:{{ fpm_socket }}|fcgi://localhost"
        </FilesMatch>

        Header always set X-Content-Type-Options "nosniff"
        Header always set X-Frame-Options "DENY"
        Header always set Referrer-Policy "same-origin"
        Header always set Content-Security-Policy "frame-ancestors 'none'; base-uri 'none'; object-src 'none'"

        # Tylko ścieżka, bez zapytania (?pwd=, kod i state z logowania) i bez Referer/Location.
        ErrorLog ${APACHE_LOG_DIR}/{{ domain }}-error.log
        SetEnvIf Request_URI "^(.*)$" APP_LOG_PATH=$1
        CustomLog ${APACHE_LOG_DIR}/{{ domain }}-access.log "%a %t \"%m %{APP_LOG_PATH}e %H\" %>s %B %D \"%{User-Agent}i\""
{% endmacro %}
<VirtualHost *:80>
{{ app_config() }}
{% if https_enabled | bool %}
        # /api/ bez przekierowania: klienci API wołają stare adresy http://,
        # a przekierowanie zamieniłoby ich POST-y w GET-y.
        RewriteEngine on
        RewriteCond %{REQUEST_URI} !^/api/
        RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
        RewriteRule ^ https://{{ domain }}%{REQUEST_URI} [END,NE,R=permanent]
{% endif %}
</VirtualHost>
{% if https_enabled | bool %}

<IfModule mod_ssl.c>
<VirtualHost *:443>
{{ app_config() }}
        # To najwcześniejszy vhost z :443, więc odbiera też żądania do stron bez własnego vhosta SSL.
        RewriteEngine on
        RewriteCond %{HTTP_HOST} ^www\.{{ domain | regex_escape }}(:443)?$ [NC]
        RewriteRule ^ https://{{ domain }}%{REQUEST_URI} [END,NE,R=permanent]
        RewriteCond %{HTTP_HOST} !^{{ domain | regex_escape }}(:443)?$ [NC]
        RewriteRule ^ - [END,R=404]

        Include /etc/letsencrypt/options-ssl-apache.conf
        SSLCertificateFile {{ letsencrypt_cert_dir }}/fullchain.pem
        SSLCertificateKeyFile {{ letsencrypt_cert_dir }}/privkey.pem
</VirtualHost>
</IfModule>
{% endif %}
