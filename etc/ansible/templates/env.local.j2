# {{ ansible_managed }}
APP_ENV=prod
APP_DEBUG=0
APP_SECRET='{{ app_secret }}'

DATABASE_URL='mysql://{{ db_user | urlencode | replace("/", "%2F") | replace("%", "%%") }}:{{ db_password | urlencode | replace("/", "%2F") | replace("%", "%%") }}@{{ db_host }}:{{ db_port }}/{{ db_name }}?serverVersion={{ db_server_version }}&charset=utf8mb4'

API_PASSWORD='{{ api_password }}'

ONESIGNAL_APP_ID='{{ onesignal_app_id }}'
ONESIGNAL_REST_API_KEY='{{ onesignal_rest_api_key }}'
