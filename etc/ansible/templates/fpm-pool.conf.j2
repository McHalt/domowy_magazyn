; {{ ansible_managed }}
[{{ app_user }}]
user = {{ app_user }}
group = {{ app_user }}

; Apache łączy się już jako {{ app_user }} (mpm_itk, AssignUserId), więc inne konta nie potrzebują dostępu do gniazda.
listen = {{ fpm_socket }}
listen.owner = {{ app_user }}
listen.group = {{ app_user }}
listen.mode = 0660

pm = ondemand
pm.max_children = 5
pm.process_idle_timeout = 30s
pm.max_requests = 500
request_terminate_timeout = 60s

php_admin_flag[log_errors] = on
php_admin_value[error_log] = {{ shared_dir }}/var/log/php-fpm.log
php_admin_value[memory_limit] = 256M
php_admin_flag[zend.exception_ignore_args] = on
