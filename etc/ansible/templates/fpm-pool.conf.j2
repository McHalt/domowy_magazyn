; {{ ansible_managed }}
[{{ app_name }}]
; Ten sam użytkownik co AssignUserId (mpm_itk) w vhoście i właściciel plików
; z rsynca — bez tego var/cache i var/log nie byłyby zapisywalne.
user = {{ ansible_user }}
group = {{ ansible_user }}

listen = {{ fpm_socket }}
listen.owner = {{ ansible_user }}
listen.group = www-data
listen.mode = 0660

pm = ondemand
pm.max_children = 5
pm.process_idle_timeout = 30s
pm.max_requests = 500

php_admin_flag[log_errors] = on
php_admin_value[error_log] = {{ deploy_to }}/shared/var/log/php-fpm.log
php_admin_value[memory_limit] = 256M
