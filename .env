APP_ENV=dev
APP_SECRET=change_me_to_a_random_32char_string
APP_DEBUG=1

# mysql://USER:PASS@HOST:PORT/DBNAME?serverVersion=8.0&charset=utf8mb4
DATABASE_URL="mysql://app:app@db:3306/domowy_magazyn?serverVersion=8.0&charset=utf8mb4"

ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Hasło do API (odpowiednik api/pwd.php z PWD const)
API_PASSWORD=

# Katalog współdzielony między wydaniami (cache JWKS); w produkcji shared/var/share
APP_SHARE_DIR=var/share
LOCK_DSN=flock

# Hub domowy (logowanie OIDC, API, zdarzenia). Bez HUB_ISSUER i HUB_CLIENT_SECRET web odpowiada 503.
APP_PUBLIC_URL=http://localhost:8080
HUB_ISSUER=
HUB_INTERNAL_URL=
HUB_CLIENT_ID=module-magazyn
HUB_CLIENT_SECRET=
HUB_EVENT_KEY=
