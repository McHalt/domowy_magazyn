{% extends 'base.html.twig' %}
{% block title %}404 – Nie znaleziono{% endblock %}

{% block body %}
<div class="row justify-content-center mt-5">
    <div class="col-md-5 text-center">
        <div class="card shadow-sm">
            <div class="card-body py-5">
                <div class="display-1 mb-3">🔍</div>
                <h2 class="card-title">Strona nie znaleziona</h2>
                <p class="text-muted mb-4">Żądana strona nie istnieje lub została przeniesiona.</p>
                <a href="{{ path('main') }}" class="btn btn-primary">← Wróć na stronę główną</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
