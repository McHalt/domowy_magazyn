{% extends 'base.html.twig' %}
{% block title %}Grupy produktów – Domowy Magazyn{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">🗂️ Grupy produktów</h4>
    <a href="{{ path('group_add') }}" class="btn btn-success btn-sm">➕ Dodaj grupę</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Nazwa</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for group in groups %}
            <tr>
                <td>{{ group.name }}</td>
                <td class="text-end">
                    <a href="{{ path('group_view', {id: group.id}) }}" class="btn btn-sm btn-outline-primary">Zobacz</a>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="2" class="text-center text-muted py-4">Brak grup</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
