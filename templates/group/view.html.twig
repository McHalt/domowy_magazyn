{% extends 'base.html.twig' %}
{% block title %}{{ group.name }} – Domowy Magazyn{% endblock %}

{% block body %}
<div class="d-flex align-items-center gap-2 mb-4">
    <a href="{{ path('groups_list') }}" class="btn btn-sm btn-outline-secondary">← Wróć</a>
    <h4 class="mb-0">🗂️ {{ group.name }}</h4>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-7">
        {% include '_min_stock_card.html.twig' with {
            action: path('group_min_stock', {id: group.id}),
            noAmountHint: 'Ustaw jednostkę grupy, żeby liczyć łączną ilość.',
        } %}
    </div>
    <div class="col-md-5">
        <div class="card h-100">
            <div class="card-header fw-semibold">Jednostka grupy</div>
            <div class="card-body">
                <form method="post" action="{{ path('group_unit', {id: group.id}) }}" class="d-flex gap-2">
                    <select name="unit" class="form-select form-select-sm" aria-label="Jednostka grupy">
                        <option value="">— brak —</option>
                        {% for unit in units %}
                            <option value="{{ unit.value }}" {{ group.unit == unit ? 'selected' }}>{{ unit.value }}</option>
                        {% endfor %}
                    </select>
                    <button type="submit" class="btn btn-sm btn-outline-primary">Ustaw</button>
                </form>
                <div class="form-text">
                    Do grupy trafiają tylko produkty w zgodnej jednostce (g↔kg, ml↔l).
                    Zmiana na niezgodną jednostkę usuwa minimum ilości.
                </div>
                {% if group.unit and group.productsSkippedInAmount is not empty %}
                    <div class="small text-muted mt-2">
                        Nieliczone w ilości (brak jednostki lub ilości w opakowaniu):
                        {% for product in group.productsSkippedInAmount %}
                            <a href="{{ path('product_view', {id: product.id}) }}">{{ product.featuresMap.name ?? product.ean }}</a>{{ not loop.last ? ',' }}
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th class="col-ean">EAN</th>
                <th>Producent</th>
                <th>Nazwa</th>
                <th class="text-center">Ilość</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for product in group.products %}
            <tr>
                <td class="col-ean text-muted small">{{ product.ean }}</td>
                <td>{{ product.featuresMap.producer ?? '' }}</td>
                <td>{{ product.featuresMap.name ?? '' }}</td>
                <td class="text-center">
                    <span class="badge {% if product.qty == 0 %}bg-secondary{% elseif product.qty <= 2 %}bg-warning text-dark{% else %}bg-success{% endif %} fs-6">
                        {{ product.qty }}
                    </span>
                </td>
                <td class="text-end">
                    <a href="{{ path('product_view', {id: product.id}) }}" class="btn btn-sm btn-outline-primary">Zobacz</a>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="5" class="text-center text-muted py-4">Brak produktów w tej grupie</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
