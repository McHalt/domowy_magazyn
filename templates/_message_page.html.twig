{% extends 'base.html.twig' %}

{% block body %}
<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card shadow-sm">
            <div class="card-body py-5">
                <div class="display-1 mb-3">{% block icon %}{% endblock %}</div>
                <h2 class="card-title">{% block heading %}{% endblock %}</h2>
                <p class="text-muted mb-4">{% block message %}{% endblock %}</p>
                {% block actions %}{% endblock %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
