{% extends 'base.html.twig' %}
{% block title %}Zdejmij produkt – Domowy Magazyn{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-6">

        {% for error in errors %}
            <div class="alert alert-danger">{{ error }}</div>
        {% endfor %}
        {% for warning in warnings %}
            <div class="alert alert-warning">{{ warning }}</div>
        {% endfor %}

        {% if errors is empty and product is defined %}
            <div class="card shadow-sm">
                <div class="card-header fw-semibold">
                    Wybierz termin ważności
                    <span class="text-muted small ms-2 font-monospace">{{ product.ean }}</span>
                </div>
                <div class="list-group list-group-flush">
                    {% for date in expirationDates %}
                        <a href="{{ path('product_remove', {ean: product.ean, date: date}) }}"
                           class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            {{ date ?? 'Brak daty' }}
                            <span class="badge bg-danger">Zdejmij</span>
                        </a>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

    </div>
</div>
{% endblock %}
